# --- TMDB API ---
# Get a FREE API key (v3 auth) at: https://www.themoviedb.org/settings/api
# Copy this file to `.env` and paste your key below.
# Expo automatically inlines EXPO_PUBLIC_* variables at build time.
EXPO_PUBLIC_TMDB_API_KEY=your_tmdb_v3_api_key_here

# --- Supabase (accounts + cross-device sync) ---
# Create a free project at https://supabase.com, then copy Project Settings → API:
#   Project URL  → EXPO_PUBLIC_SUPABASE_URL
#   anon/public (or publishable) key → EXPO_PUBLIC_SUPABASE_ANON_KEY  (safe to embed; RLS protects data)
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
