# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Android release signing (secrets — keep local backups, never commit)
credentials/

# Built APKs (too large for GitHub; distribute out-of-band)
*.apk

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local
!.env.example

# typescript
*.tsbuildinfo

# Claude Code (local, personal — keep shared .claude/settings.json tracked)
.claude/settings.local.json

example

# generated native folders
/ios
/android
