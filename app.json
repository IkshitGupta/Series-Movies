{
  "expo": {
    "name": "Seen It",
    "slug": "MoviesSeriesHub",
    "owner": "sting1712s-team",
    "version": "1.0.6",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "moviesserieshub",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/b9f72627-0b03-4eea-8a9c-023f7e65c20d",
      "enabled": true,
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    },
    "ios": {
      "bundleIdentifier": "com.moviesserieshub.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.moviesserieshub.app",
      "versionCode": 7,
      "adaptiveIcon": {
        "backgroundColor": "#010102",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#010102",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 180
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "b9f72627-0b03-4eea-8a9c-023f7e65c20d"
      },
      "updateManifestUrl": "https://raw.githubusercontent.com/IkshitGupta/Series-Movies/main/update-manifest.json"
    }
  }
}
